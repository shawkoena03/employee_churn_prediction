# =========================================================================
# SMTP Configuration (For actual email notifications)
# Rename this file to '.env' and populate with your own mail server details.
# =========================================================================

# SMTP Server details (e.g., sandbox.smtp.mailtrap.io)
SMTP_SERVER=sandbox.smtp.mailtrap.io
SMTP_PORT=2525

# Your SMTP credentials (from your Mailtrap Inbox -> SMTP Settings tab)
SMTP_USERNAME=your_mailtrap_username
SMTP_PASSWORD=your_mailtrap_password

# Default Email Settings
SENDER_EMAIL=agent@company.com
HR_RECEIVER_EMAIL=hr@company.com

# Groq / Gemini API Configuration
GEMINI_API_KEY="your_gemini_api_key_here"
